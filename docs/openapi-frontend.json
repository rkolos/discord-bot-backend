            }
          }
        }
      },
      "BotStatusResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["online", "offline", "error"] },
              "lastSeen": { "type": "string", "nullable": true },
              "version": { "type": "string" }
            }
          }
        }
      },
      "ActivityChartPoint": {
        "type": "object",
        "properties": {
