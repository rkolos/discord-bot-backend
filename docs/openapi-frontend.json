              "activeMembers24h": { "type": "integer" },
              "activeMembers7d": { "type": "integer" }
            }
          }
        }
      },
      "TopChannelItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "voice"] },
          "value": { "type": "integer" }
        }
      },
      "TopMemberItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "discriminator": { "type": "string" },
          "avatar": { "type": "string" },
          "messages": { "type": "integer" },
          "voiceMinutes": { "type": "integer" }
        }
      },
      "RoleDistributionItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "count": { "type": "integer" }
        }
      },
      "TopCommandItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "usageCount": { "type": "integer" },
          "lastUsedAt": { "type": "string" },
          "category": { "type": "string" }
        }
      },
      "CombinedAnalyticsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "timeSeries": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ActivityChartPoint" }
              },
              "heatmap": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dayOfWeek": { "type": "integer" },
                    "hour": { "type": "integer" },
                    "value": { "type": "integer" }
                  }
                }
              },
              "summary": {
                "type": "object",
                "properties": {
                  "totalMessages": { "type": "integer" },
                  "totalMembers": { "type": "integer" },
                  "totalVoiceMinutes": { "type": "integer" },
                  "averageMessagesPerDay": { "type": "number" },
                  "averageMembersPerDay": { "type": "number" }
                }
              },
              "topChannels": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/TopChannelItem" }
                  },
                  "voice": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/TopChannelItem" }
                  }
                }
              },
              "topMembers": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/TopMemberItem" }
              },
              "roleDistribution": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/RoleDistributionItem" }
              },
              "topCommands": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/TopCommandItem" }
              }
            }
          }
        }
      },
      "ActivitySparklineResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "type": "number" },
            "description": "Message counts per hour for last 24 hours (most recent first)."
          },
          "level": {
            "type": "string",
            "enum": ["live", "active", "quiet"],
            "description": "Activity level: live = bot connected; active = last 24h ≥ 1 message; quiet = last 24h < 1 or no data."
          }
        },
        "required": ["data", "level"]
      }
    }
