# -----------------------------------------------------------------------------
# Все переменные, необходимые для запуска приложений (frontend-api, admin-api и др.).
# Скопируйте в .env и при необходимости подставьте свои значения и секреты.
# Docker Compose: в контейнерах используйте имена сервисов как хосты (postgres, redis, clickhouse).
# -----------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sn
# Для запуска внутри Docker Compose:
# POSTGRES_HOST=postgres
DB_HOST=postgres
DB_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # опционально
# Для Docker: REDIS_HOST=redis

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_DB=default
# CLICKHOUSE_NATIVE_PORT=9000  # при необходимости
# Для Docker: CLICKHOUSE_HOST=clickhouse

# --- API base URLs (для клиентов) ---
FRONTEND_API_URL=http://localhost:3000
ADMIN_API_URL=http://localhost:3001

# --- JWT и шифрование (обязательны для запуска) ---
# Секрет для подписи JWT (frontend-api). Должен быть непустым.
JWT_SECRET=change_me_jwt_secret_min_32_chars
# Секрет для JWT админки (admin-api). Если не задан, admin-api не запустится.
ADMIN_JWT_SECRET=change_me_admin_jwt_secret
# Ключ AES-256-GCM, ровно 32 символа (spec 10.3).
ENCRYPTION_KEY_V1=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# --- Discord OAuth2 (frontend-api) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Окружение ---
# NODE_ENV=development  # по умолчанию development

# --- Admin API: первый SuperAdmin (скрипт npm run create-super-admin) ---
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=adminpassword
ADMIN_NAME=adminname

# --- Опционально ---
# ADMIN_VPN_SUBNET=  # CIDR для доступа к Admin API
# HISTORY_SCAN_DEPTH=500
# HISTORY_SCAN_CONCURRENCY=3
