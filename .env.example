# -----------------------------------------------------------------------------
# Docker Compose: use service names as hosts (postgres, redis, clickhouse).
# Copy to .env and fill in secrets.
# Если порты 6379/3000 заняты, в compose Redis=6380:6379, Frontend API=3002:3000.
# -----------------------------------------------------------------------------

# --- PostgreSQL (postgres service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sn
# Для запуска внутри Docker Compose в контейнере задаётся POSTGRES_HOST=postgres.
DB_HOST=postgres
DB_PORT=5432

# --- Redis (redis service) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- ClickHouse (clickhouse service) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- API base URLs (for clients) ---
FRONTEND_API_BASE_URL=http://localhost:3000
ADMIN_API_BASE_URL=http://localhost:3001

# --- Encryption (spec 10.3) ---
# ENCRYPTION_KEY_V1=  # AES-256-GCM key for token encryption (32 bytes hex)

# --- Admin API (optional) ---
# ADMIN_VPN_SUBNET=  # CIDR or list of allowed subnets for Admin API

# --- History import (spec 10.3) ---
# HISTORY_SCAN_DEPTH=500   # 100–1000
# HISTORY_CONCURRENCY=3    # 1–10
