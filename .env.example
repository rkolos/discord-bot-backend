# -----------------------------------------------------------------------------
# Все переменные, необходимые для запуска приложений (frontend-api, admin-api и др.).
# Скопируйте в .env и при необходимости подставьте свои значения и секреты.
# Docker Compose: в контейнерах используйте имена сервисов как хосты (postgres, redis, clickhouse).
# -----------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sn
# Для запуска внутри Docker Compose:
# POSTGRES_HOST=postgres
DB_HOST=postgres
DB_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # опционально
# Для Docker: REDIS_HOST=redis

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_DB=default
# CLICKHOUSE_NATIVE_PORT=9000  # при необходимости
# Для Docker: CLICKHOUSE_HOST=clickhouse

# --- API base URLs (для клиентов) ---
FRONTEND_API_URL=http://localhost:3000
ADMIN_API_URL=http://localhost:3001

# --- JWT и шифрование (обязательны для запуска) ---
# Секрет для подписи JWT (frontend-api). Должен быть непустым.
JWT_SECRET=change_me_jwt_secret_min_32_chars
# Секрет для JWT админки (admin-api). Если не задан, admin-api не запустится.
ADMIN_JWT_SECRET=change_me_admin_jwt_secret
# Ключ AES-256-GCM, ровно 32 символа (spec 10.3).
ENCRYPTION_KEY_V1=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# --- Add Bot: переменные для синхронизации с фронтендом ---
# Фронтенд-разработчик должен настроить переменные, совпадающие с FRONTEND_BASE_URL и API URL:
#   NEXT_PUBLIC_API_URL / VITE_API_URL = URL бэкенд API (например http://localhost:3001)
#   NEXT_PUBLIC_APP_URL / VITE_APP_URL = FRONTEND_BASE_URL (origin фронтенда)

# --- Discord OAuth2 (frontend-api) ---
# Client ID и Client Secret из Discord Developer Portal → OAuth2 → General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# URL, куда Discord перенаправляет после авторизации. Должен быть в Discord Portal → OAuth2 → Redirects.
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Origin фронтенд-приложения для валидации redirect_uri и fallback при ошибках OAuth
FRONTEND_BASE_URL=http://localhost:3010
# CORS: Frontend API — FRONTEND_BASE_URL; Admin API — ADMIN_PANEL_URL
# ADMIN_PANEL_URL=http://localhost:3020
# CORS_ORIGIN=  # переопределяет для обоих API при необходимости

# --- Окружение ---
# NODE_ENV=development  # по умолчанию development

# --- Admin API: первый SuperAdmin (скрипт npm run create-super-admin) ---
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=adminpassword
ADMIN_NAME=adminname

# --- Bot token (bot-service, ingestor-worker) ---
# Токен приложения бота из Discord Developer Portal. Нужен для:
#   - bot-service: подключение к Gateway, Discord REST API
#   - ingestor-worker: Guild Setup (First Contact), History Sync (импорт истории сообщений)
# DISCORD_BOT_TOKEN=

# --- Опционально ---
# ADMIN_VPN_SUBNET=  # CIDR для доступа к Admin API

# History Sync (ingestor-worker): глубина и параллелизм импорта истории
# HISTORY_SCAN_DEPTH=100   # сообщений на канал (100-1000)
# HISTORY_CONCURRENCY=2    # каналов параллельно (1-10)
# Guild reconciliation (bot-service): GUILD_RECONCILIATION_ENABLED=false отключает сверку
# GUILD_RECONCILIATION_ENABLED=
# GUILD_RECONCILIATION_CRON=  # по умолчанию каждые 15 мин (0 */15 * * * *)
