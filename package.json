{
  "name": "discord-stat-bot-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "precommit-check": "npm run lint && npm run typecheck && npm run build",
    "build": "nest build frontend-api && nest build admin-api && nest build bot-service && nest build ingestor-worker && nest build background-worker",
    "build:frontend-api": "nest build frontend-api",
    "build:admin-api": "nest build admin-api",
    "build:bot-service": "nest build bot-service",
    "build:ingestor-worker": "nest build ingestor-worker",
    "build:background-worker": "nest build background-worker",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:frontend-api": "nest start --watch frontend-api",
    "start:dev:admin-api": "nest start --watch admin-api",
    "start:dev:bot-service": "nest start --watch bot-service",
    "start:dev:ingestor-worker": "nest start --watch ingestor-worker",
    "start:dev:background-worker": "nest start --watch background-worker",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d libs/shared/src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d libs/shared/src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d libs/shared/src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "joi": "^17.13.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^10.0.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.54.0"
  }
}
